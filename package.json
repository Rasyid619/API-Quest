{
  "name": "api-quest",
  "version": "0.1.0",
  "description": "API Quest assessment service built from the TypeScript service template.",
  "engines": {
    "node": ">=24.14.1 <26.0.0"
  },
  "license": "UNLICENSED",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "clean": "rm -rf ./dist",
    "build": "tsc --project tsconfig.build.json",
    "lint": "eslint . && markdownlint '**/*.md' --ignore '**/node_modules/**' && yamllint '**/*.yml' '**/*.yaml' --ignore '**/node_modules/**'",
    "lint:fix": "eslint --fix . && markdownlint --fix '**/*.md' --ignore '**/node_modules/**'",
    "migrate": "node-pg-migrate",
    "openapi:bundle": "redocly bundle ./openapi.yml --output ./openapi/openapi-bundled.yaml",
    "start": "node --enable-source-maps ./dist/index.js",
    "test": "jest --coverage --runInBand",
    "test:nocov": "jest --runInBand"
  },
  "packageManager": "yarn@4.13.0",
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "pg": "^8.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@jest-mock/express": "^3.0.0",
    "@redocly/cli": "^2.25.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "dotenv": "^17.4.0",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "jest": "^30.3.0",
    "markdownlint-cli": "^0.48.0",
    "node-pg-migrate": "^8.0.4",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.2",
    "yaml-lint": "^1.7.0"
  },
  "jest": {
    "preset": "ts-jest",
    "globalSetup": "<rootDir>/test/global-setup.ts",
    "setupFiles": [
      "dotenv/config"
    ],
    "testEnvironment": "node",
    "testRegex": "(/__tests__/.*|(\\.|/)(test|spec))\\.tsx?$",
    "coverageThreshold": {
      "global": {
        "branches": 95,
        "functions": 95,
        "lines": 95,
        "statements": 95
      }
    },
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "./tsconfig.test.json"
        }
      ]
    }
  }
}
