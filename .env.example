PORT=
# Postgres connection string.
# Local: postgres://postgres:postgres@localhost:5432/apiquest
# Render: use the database's Internal URL on the platform, or the External URL
# with ?sslmode=require from your machine.
DATABASE_URL=
# HS256 secret used to sign and verify access tokens.
ACCESS_TOKEN_PUBLIC_KEY=
# Credentials accepted by POST /auth/token.
AUTH_USERNAME=admin
AUTH_PASSWORD=password
